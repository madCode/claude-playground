<?xml version="1.0" encoding="utf-8"?>
<!-- Keep in step with backup_rules.xml.
     Nothing the writer wrote goes to the cloud backup: drafts, photos and the privacy settings
     would sit in their Google account, beside the blog's account and repository, which ties the
     two together. Moving to a new phone (device transfer) brings them, as it's from hand to hand.
     The GitHub token never moves: it's sealed by a Keystore key that never leaves this phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/account.preferences_pb" />
        <exclude domain="file" path="datastore/settings.preferences_pb" />
        <exclude domain="file" path="images" />
        <exclude domain="database" path="poster.db" />
        <exclude domain="database" path="poster.db-wal" />
        <exclude domain="database" path="poster.db-shm" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/account.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
