<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older, where one set of rules covers both the cloud backup and moving to a
     new phone: kept out of both, for the reasons in data_extraction_rules.xml. -->
<full-backup-content>
    <exclude domain="file" path="datastore/account.preferences_pb" />
    <exclude domain="file" path="datastore/settings.preferences_pb" />
    <exclude domain="file" path="images" />
    <exclude domain="database" path="poster.db" />
    <exclude domain="database" path="poster.db-wal" />
    <exclude domain="database" path="poster.db-shm" />
</full-backup-content>
