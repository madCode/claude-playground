<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later: the same as backup_rules.xml, for cloud backup and phone-to-phone transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
