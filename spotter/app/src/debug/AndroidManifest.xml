<?xml version="1.0" encoding="utf-8"?>
<!--
  A CI debug build installs newer CI builds of itself (update/), because madCode asked for an app
  that updates itself without them doing anything. Debug only: app stores refuse an app that can
  install apps.

  - INTERNET: to fetch the debug release's spotter-debug.json and the build it names.
  - REQUEST_INSTALL_PACKAGES: to hand the build to Android's installer. Android asks once to
    allow it ("Install unknown apps").
  - UPDATE_PACKAGES_WITHOUT_USER_ACTION: so Android 12 and later install an update Spotter
    installed itself without asking. Without it every install waits for a tap, which a
    background install never shows.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <application>
        <receiver
            android:name="spotter.app.update.InstallResult"
            android:exported="false" />
    </application>
</manifest>
