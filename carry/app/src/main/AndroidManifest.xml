<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      Three permissions are this app's own:

      - POST_NOTIFICATIONS, added 2026-10-16 so a session file landing in
        the synced folder can say so. The notification text carries the
        class only (see NewSession.text).
      - INTERNET, added 2026-10-16 at the owner's choice (claude-playground
        #107) for one thing: asking GitHub whether a newer debug build is
        out (DebugUpdates). Only a CI debug build asks, at most every three
        hours, and the request carries nothing of the owner's. The session
        files still never leave except through the share sheet.
      - REQUEST_INSTALL_PACKAGES, with INTERNET, so a tap on "Build N is
        out" can download that build and hand it to Android's installer
        (UpdateInstaller). Android still asks the owner to allow it once,
        and to confirm each install unless it lets the app update itself.

      THIS FILE IS NOT THE WHOLE ANSWER. androidx.work brings four more
      (WAKE_LOCK, RECEIVE_BOOT_COMPLETED, ACCESS_NETWORK_STATE and
      FOREGROUND_SERVICE) which appear only in the MERGED manifest.
      `aapt2 dump permissions` on the built APK is the honest check;
      docs/DESIGN.md carries the table and the reasons.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="Carry"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Carry">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Carry">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver
            android:name=".UpdateInstaller$Result"
            android:exported="false" />
    </application>
</manifest>
