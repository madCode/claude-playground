<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      POST_NOTIFICATIONS is this app's own, added 2026-10-16 so a session
      file landing in the synced folder can say so. The notification text
      carries the class only (see NewSession.text).

      A debug build adds INTERNET and REQUEST_INSTALL_PACKAGES in
      src/debug/AndroidManifest.xml, to install newer CI builds of itself.
      A release build asks for neither; `check` fails if it does.

      THIS FILE IS NOT THE WHOLE ANSWER. androidx.work brings four more
      (WAKE_LOCK, RECEIVE_BOOT_COMPLETED, ACCESS_NETWORK_STATE and
      FOREGROUND_SERVICE) which appear only in the MERGED manifest.
      `aapt2 dump permissions` on the built APK is the honest check;
      docs/DESIGN.md carries the table and the reasons.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="Carry"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Carry">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Carry">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
